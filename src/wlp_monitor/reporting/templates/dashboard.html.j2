<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WeLovePilates Monitor</title>
<style>
  :root {
    --bg: #f6f7f9; --card: #ffffff; --text: #1a1d21; --muted: #6b7280;
    --border: #e5e7eb; --accent: #c2185b;
    --ok: #15803d; --ok-bg: #dcfce7;
    --warning: #b45309; --warning-bg: #fef3c7;
    --error: #b91c1c; --error-bg: #fee2e2;
    --info: #1d4ed8; --info-bg: #dbeafe;
    --nc: #4b5563; --nc-bg: #f3f4f6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115; --card: #191c22; --text: #e6e8eb; --muted: #9aa1ab;
      --border: #2a2e37; --accent: #f472b6;
      --ok: #4ade80; --ok-bg: #14321f;
      --warning: #fbbf24; --warning-bg: #3a2c08;
      --error: #f87171; --error-bg: #3a1414;
      --info: #93c5fd; --info-bg: #16233f;
      --nc: #cbd5e1; --nc-bg: #23272f;
    }
  }
  * { box-sizing: border-box; }
  body { margin:0; font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
         background:var(--bg); color:var(--text); line-height:1.5; }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 24px 16px 64px; }
  header.top { display:flex; align-items:center; gap:16px; flex-wrap:wrap; margin-bottom: 8px; }
  header.top h1 { font-size: 1.5rem; margin:0; }
  .sub { color:var(--muted); font-size:.9rem; margin-bottom:24px; }
  .badge { display:inline-flex; align-items:center; gap:6px; padding:4px 12px; border-radius:999px;
           font-size:.85rem; font-weight:600; }
  .st-ok{background:var(--ok-bg);color:var(--ok);}
  .st-warning{background:var(--warning-bg);color:var(--warning);}
  .st-error{background:var(--error-bg);color:var(--error);}
  .st-info{background:var(--info-bg);color:var(--info);}
  .st-not_configured{background:var(--nc-bg);color:var(--nc);}
  .card { background:var(--card); border:1px solid var(--border); border-radius:14px;
          padding:20px; margin-bottom:16px; }
  .card h2 { margin:0 0 4px; font-size:1.15rem; display:flex; align-items:center; gap:10px; justify-content:space-between;}
  .card h2 .t { display:flex; align-items:center; gap:10px; }
  .card .summary { color:var(--muted); margin:0 0 14px; }
  .metrics { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:14px; }
  .metric { background:var(--bg); border:1px solid var(--border); border-radius:10px; padding:8px 14px; min-width:120px; }
  .metric .k { font-size:.72rem; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); }
  .metric .v { font-size:1.15rem; font-weight:700; }
  ul.sugg { margin:8px 0 0; padding-left: 20px; }
  ul.sugg li { margin-bottom:6px; }
  .setup { background:var(--nc-bg); border-radius:10px; padding:12px 14px; font-size:.9rem; color:var(--nc); }
  table { width:100%; border-collapse:collapse; font-size:.88rem; margin-top:6px; }
  .scroll { overflow-x:auto; }
  th,td { text-align:left; padding:7px 10px; border-bottom:1px solid var(--border); white-space:nowrap; }
  th { color:var(--muted); font-weight:600; font-size:.78rem; text-transform:uppercase; }
  .row-error td:first-child { border-left:3px solid var(--error); }
  .row-warning td:first-child { border-left:3px solid var(--warning); }
  .spark { height:32px; }
  .heat td { text-align:center; font-variant-numeric:tabular-nums; border:1px solid var(--border); min-width:34px; }
  .actions { background:linear-gradient(135deg, rgba(194,24,91,.08), transparent); }
  footer { color:var(--muted); font-size:.8rem; text-align:center; margin-top:32px; }
  a { color:var(--accent); }
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <h1>🩷 WeLovePilates Monitor</h1>
    <span class="badge st-{{ report.overall_status }}">{{ status_emoji[report.overall_status] }} {{ status_label[report.overall_status] }}</span>
  </header>
  <div class="sub">
    Stand: {{ report.date }} · <a href="{{ report.site }}">{{ report.site }}</a>
    {% if trends %} · Historie: {{ trends.days }} Tage{% endif %}
  </div>

  {% if report.demo %}
  <div class="card" style="border-color:var(--warning); background:var(--warning-bg)">
    <strong>⚠️ Beispiel-Ansicht mit Demo-Daten.</strong> So sieht das Dashboard aus,
    sobald die Zugangsdaten (Wix, Google Ads, Search Console) hinterlegt sind.
    Der erste echte Lauf ersetzt diese Seite. Siehe <code>SETUP.md</code>.
  </div>
  {% endif %}

  {% if report.suggestions %}
  <div class="card actions">
    <h2><span class="t">🎯 Wichtigste Handlungsempfehlungen</span></h2>
    <ul class="sugg">
      {% for s in report.suggestions[:8] %}
      <li><strong>{{ s.bereich }}:</strong> {{ s.vorschlag }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if trends and trends.series %}
  <div class="card">
    <h2><span class="t">📈 Trends</span></h2>
    <div class="metrics">
      {% for tr in trends.series %}
      <div class="metric" style="min-width:180px;">
        <div class="k">{{ tr.label }}</div>
        <div class="v">{{ tr.last }}</div>
        {{ tr.svg | safe }}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% for sec in report.sections %}
  <div class="card">
    <h2>
      <span class="t">{{ status_emoji[sec.status] }} {{ sec.title }}</span>
      <span class="badge st-{{ sec.status }}">{{ status_label[sec.status] }}</span>
    </h2>
    <p class="summary">{{ sec.summary }}</p>

    {% if sec.status == 'not_configured' and sec.setup_hint %}
      <div class="setup">⚙️ {{ sec.setup_hint }}</div>
    {% endif %}
    {% if sec.error_detail %}
      <div class="setup">🚨 {{ sec.error_detail }}</div>
    {% endif %}

    {% set simple_metrics = sec.metrics | simple_metrics %}
    {% if simple_metrics %}
    <div class="metrics">
      {% for k, v in simple_metrics %}
      <div class="metric"><div class="k">{{ k }}</div><div class="v">{{ v }}</div></div>
      {% endfor %}
    </div>
    {% endif %}

    {# --- Buchungs-Heatmap --- #}
    {% if sec.key == 'bookings' and sec.metrics.heatmap and sec.metrics.heatmap.grid %}
      {% set hm = sec.metrics.heatmap %}
      <div class="scroll"><table class="heat">
        <tr><th></th>{% for h in hm.hours %}<th>{{ '%02d'|format(h) }}</th>{% endfor %}</tr>
        {% for wd in hm.weekdays %}
        <tr><th>{{ wd }}</th>
          {% for val in hm.grid[loop.index0] %}
            {% if val is none %}<td style="color:var(--muted)">·</td>
            {% else %}<td style="background: {{ val | heat_color }}; color:{{ val | heat_text }}">{{ val }}%</td>{% endif %}
          {% endfor %}
        </tr>
        {% endfor %}
      </table></div>
      <p class="sub" style="margin-top:8px">Auslastung je Zeitfenster (Wochentag × Uhrzeit)</p>
    {% endif %}

    {% set rows = sec['items'] %}
    {% if rows %}
    <div class="scroll"><table>
      <tr>{% for col in rows[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr>
      {% for item in rows[:25] %}
      <tr class="row-{{ item.status if item.status is defined else '' }}">
        {% for col in rows[0].keys() %}<td>{{ item[col] }}</td>{% endfor %}
      </tr>
      {% endfor %}
    </table></div>
    {% endif %}

    {% if sec.suggestions %}
    <ul class="sugg">
      {% for s in sec.suggestions %}<li>{{ s }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}

  <footer>
    Automatisch erzeugt vom WeLovePilates Monitor · {{ report.generated_at }}
  </footer>
</div>
</body>
</html>
