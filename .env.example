# ============================================================================
# WeLovePilates Monitor — Geheime Zugangsdaten (Vorlage)
# ============================================================================
# Kopiere diese Datei nach ".env" und trage deine echten Werte ein (lokal).
# In GitHub Actions werden diese Werte als "Repository Secrets" hinterlegt
# (Settings -> Secrets and variables -> Actions).  Siehe SETUP.md.
#
# NIEMALS die echte .env committen!  (steht bereits in .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# E-Mail-Versand (SMTP).  Für Gmail: App-Passwort erstellen (nicht das normale
# Passwort!) unter https://myaccount.google.com/apppasswords
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine-adresse@gmail.com
SMTP_PASSWORD=dein-app-passwort
# Optional abweichender Absender (Standard = SMTP_USER)
SMTP_FROM=

# ----------------------------------------------------------------------------
# Google Ads API
# Anleitung siehe SETUP.md (Developer-Token, OAuth-Refresh-Token, Customer-ID)
# ----------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Kundennummer OHNE Bindestriche, z.B. 1234567890
GOOGLE_ADS_CUSTOMER_ID=
# Nur nötig bei Verwaltungskonto (MCC) — sonst leer lassen
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ----------------------------------------------------------------------------
# Google Search Console (SEO)
# Service-Account-JSON als EINZEILIGER String (kompletter Inhalt der JSON-Datei).
# Der Service-Account muss in der Search Console als Nutzer hinzugefügt werden.
# ----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=

# ----------------------------------------------------------------------------
# Wix Bookings API
# API-Key + Site-ID aus dem Wix-Konto (API Keys Manager).  Siehe SETUP.md.
# ----------------------------------------------------------------------------
WIX_API_KEY=
WIX_SITE_ID=
# Nur nötig, wenn der API-Key auf Account-Ebene liegt:
WIX_ACCOUNT_ID=
